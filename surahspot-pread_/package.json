{
  "name": "surahspot",
  "version": "2.5.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:phone": "next dev -H 0.0.0.0 -p 3000",
    "dev:mock": "node scripts/with-env.mjs QF_MOCK=1 -- next dev",
    "build": "next build",
    "start": "next start",
    "start:phone": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:e2e",
    "check:credentials": "node --env-file=.env.local scripts/check-credentials.mjs",
    "probe:coverage": "node --env-file=.env.local scripts/probe-coverage.mjs",
    "verify:deploy": "node scripts/verify-deployment.mjs",
    "build:mock": "node scripts/with-env.mjs QF_MOCK=1 -- next build",
    "start:mock": "node scripts/with-env.mjs QF_MOCK=1 -- next start",
    "fetch:font": "node scripts/fetch-font.mjs",
    "check:font": "node scripts/fetch-font.mjs --check",
    "prebuild": "node scripts/fetch-font.mjs --check",
    "postinstall": "node scripts/fetch-font.mjs || echo \"Font not fetched; run 'npm run fetch:font' before building.\""
  },
  "dependencies": {
    "next": "^15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.0"
  }
}
